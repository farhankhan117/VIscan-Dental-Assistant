# ---- LLM (optional: without a key the app runs on deterministic rules) ----
# Any OpenAI-compatible provider works. Defaults below are Groq's free tier.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=8

# ---- Speech-to-text (optional) ----
# Set STT_PROVIDER=api and LLM_API_KEY to translate microphone audio from
# supported languages into English. mock is offline and only accepts .txt.
STT_PROVIDER=mock
STT_MODEL=whisper-large-v3
# STT_BASE_URL=https://api.groq.com/openai/v1

# ---- Hardening ----
# If set, every endpoint except GET / requires header  X-API-Key: <value>
API_KEY=
MAX_INPUT_CHARS=1500
MAX_UPLOAD_BYTES=10485760
SESSION_TTL_SECONDS=1800

# ---- UI ----
VISCAN_API_URL=http://127.0.0.1:8000
# VISCAN_API_KEY=   (same value as API_KEY, if you enabled it)
